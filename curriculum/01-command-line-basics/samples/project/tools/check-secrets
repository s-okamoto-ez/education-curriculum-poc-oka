#!/bin/bash
# デプロイ前に、うっかり紛れ込んだ秘密情報が無いか確認する簡易チェッカー
cd "$(dirname "$0")/.." || exit 1
echo "秘密情報のチェックを開始します..."

matches=$(grep -rnE "API_KEY|PASSWORD|SECRET" . --include="*" 2>/dev/null | grep -v "tools/check-secrets")

if [ -n "$matches" ]; then
  echo "$matches"
  echo ""
  echo "秘密情報らしき文字列が見つかりました。上を確認してください。"
  exit 1
else
  echo "問題ありませんでした。"
  exit 0
fi
